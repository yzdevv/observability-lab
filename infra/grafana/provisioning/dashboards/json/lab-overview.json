{
 "uid": "lab-overview",
 "title": "Lab overview",
 "tags": [
  "observability-lab"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "editable": false,
 "templating": {
  "list": [
   {
    "name": "impl",
    "label": "Implementation",
    "type": "custom",
    "query": "node,go",
    "multi": true,
    "includeAll": true,
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "allValue": "node|go",
    "options": []
   }
  ]
 },
 "links": [
  {
   "title": "Explore traces",
   "type": "link",
   "url": "/explore?left=%7B%22datasource%22:%22tempo%22%7D"
  }
 ],
 "panels": [
  {
   "type": "row",
   "title": "Requests through the gateway (RED metrics derived from spans)",
   "id": 1,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false
  },
  {
   "type": "timeseries",
   "title": "Request rate by implementation and scenario",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (lab_impl, lab_scenario) (rate(traces_span_metrics_calls_total{service_name=\"gateway\", span_kind=\"SPAN_KIND_SERVER\", span_name=\"POST /api/:impl/orders\", lab_impl=~\"$impl\"}[$__rate_interval]))",
     "legendFormat": "{{lab_impl}} {{lab_scenario}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     },
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "p95 latency by implementation and scenario",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "From the gateway's server span: the response time a visitor sees.",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, lab_impl, lab_scenario) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"gateway\", span_kind=\"SPAN_KIND_SERVER\", span_name=\"POST /api/:impl/orders\", lab_impl=~\"$impl\"}[$__rate_interval])))",
     "legendFormat": "{{lab_impl}} {{lab_scenario}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     },
     "unit": "ms"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Responses by status code",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "202 accepted, 429 rate limited, 503 guard or open breaker, 504 dependency timeout.",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (http_response_status_code) (rate(traces_span_metrics_calls_total{service_name=\"gateway\", span_kind=\"SPAN_KIND_SERVER\", span_name=\"POST /api/:impl/orders\", lab_impl=~\"$impl\"}[$__rate_interval]))",
     "legendFormat": "{{http_response_status_code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     },
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
